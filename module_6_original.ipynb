        "Step 12 — Load the best model from MLflow\n",
        "MLflow can retrieve a logged model using its run ID and artifact path. This demonstrates how to use the saved experiment rather than depending only on a Python variable."
      ],
      "metadata": {
        "id": "6ShIVrK52obw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import mlflow\n",
        "from mlflow.tracking import MlflowClient\n",
        "\n",
        "client = MlflowClient()\n",
        "experiment = client.get_experiment_by_name(\n",
        "    \"Group17_Ames_House_Prices\"\n",
        ")\n",
        "\n",
        "runs = mlflow.search_runs(\n",
        "    experiment_ids=[experiment.experiment_id],\n",
        "    order_by=[\"start_time DESC\"]\n",
        ")\n",
        "\n",
        "print(\"Recent runs:\")\n",
        "display(runs[[\n",
