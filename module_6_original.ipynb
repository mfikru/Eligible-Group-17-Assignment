    {
      "cell_type": "markdown",
      "source": [
        "Step 8 — Define the evaluation metrics\n",
        "The Kaggle competition evaluates submissions using Root Mean Squared Logarithmic Error (RMSLE). We will use that as our primary validation metric. Lower RMSLE is better. RMSE and MAE help you understand errors in the original dollar-price units, while R² measures how much variation in prices the model explains."
      ],
      "metadata": {
        "id": "jfKoen7Q1Ou-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import (\n",
        "    mean_squared_error,\n",
        "    mean_absolute_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "def evaluate_model(model, X_valid, y_valid):\n",
        "    predictions = np.maximum(model.predict(X_valid), 0)\n",
        "\n",
        "    rmsle = np.sqrt(\n",
        "        mean_squared_error(\n",
        "            np.log1p(y_valid),\n",
        "            np.log1p(predictions)\n",
        "        )\n",
        "    )\n",
        "\n",
        "    rmse = np.sqrt(mean_squared_error(y_valid, predictions))\n",
        "    mae = mean_absolute_error(y_valid, predictions)\n",
        "    r2 = r2_score(y_valid, predictions)\n",
        "\n",
        "    return predictions, {\n",
        "        \"RMSLE\": float(rmsle),\n",
        "        \"RMSE\": float(rmse),\n",
        "        \"MAE\": float(mae),\n",
        "        \"R2\": float(r2)\n",
        "    }"
      ],
      "metadata": {
        "id": "I5FIS5zt1RtL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
